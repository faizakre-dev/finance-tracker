    "@ionic/vue-router": "^9.0.8",
    "chart.js": "^4.5.1",
    "ionicons": "^8.1.0",
    "nanoid": "^6.0.2",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
